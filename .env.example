# AgentTest environment (copy to .env)

# API
AGENTTEST_ENV=development
AGENTTEST_API_HOST=0.0.0.0
AGENTTEST_API_PORT=8000
AGENTTEST_LOG_LEVEL=INFO

# OpenAI-compatible LLM (Ollama default)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_NUM_CTX=2048

# VRAM-aware defaults for RTX 4060 8GB
LLM_KEEP_ALIVE=5m
VRAM_PROFILE=balanced

# Paths inside containers
DATA_DIR=/data
CHARACTERS_DIR=/app/characters

# Web
VITE_API_BASE_URL=http://localhost:8000