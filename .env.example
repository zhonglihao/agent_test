AGENTTEST_ENV=development
AGENTTEST_LOG_LEVEL=INFO

# Local default. Docker Compose overrides LLM_BASE_URL to host.docker.internal.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_NUM_CTX=2048
LLM_KEEP_ALIVE=5m
LLM_TEMPERATURE=0.7
VRAM_PROFILE=balanced

CHAT_WORKING_TURNS=16
CHAT_SUMMARIZE_AFTER_TURNS=24

# Leave unset for auto repo paths; Compose sets /data and /app/characters.
# DATA_DIR=
# CHARACTERS_DIR=

VITE_API_BASE_URL=http://localhost:8000
